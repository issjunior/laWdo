{
  "name": "laudo-pericial-electron",
  "version": "0.1.4",
  "description": "Sistema de Laudos Periciais - Versão Desktop Electron",
  "main": "out/main/index.js",
  "author": "Polícia Científica do Paraná",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:diagnostico": "set LAWDO_MODO_DIAGNOSTICO=1&& npm run build:diagnostico && electron .",
    "build:diagnostico": "npm run build:preload:diagnostico && npm run build:main:diagnostico && npm run build:renderer:diagnostico && npm run diagnostico:gerar-manifesto",
    "build:main:diagnostico": "tsc -p tsconfig.main.json --sourceMap",
    "build:preload:diagnostico": "tsc -p tsconfig.preload.json --sourceMap",
    "build:renderer:diagnostico": "vite build --sourcemap",
    "diagnostico:configurar-codex": "node scripts/diagnostico/configurar-codex.mjs",
    "diagnostico:gerar-manifesto": "node scripts/diagnostico/gerar-manifesto-fontes.mjs",
    "start": "electron .",
    "prebuild": "node scripts/copy-tinymce.mjs",
    "postbuild": "node scripts/fix-imports.mjs",
    "build": "npm run build:preload && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "watch": "concurrently \"npm run watch:main\" \"npm run watch:preload\" \"npm run watch:renderer\"",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:preload": "tsc -p tsconfig.preload.json --watch",
    "watch:renderer": "vite build --watch",
    "test": "vitest run",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "spec": "node scripts/spec/index.mjs",
    "spec:auditar": "node scripts/spec/auditar.mjs",
    "spec:registrar": "node scripts/spec/registrar.mjs",
    "prune": "ts-prune -p tsconfig.renderer.json",
    "prune:all": "ts-prune -p tsconfig.renderer.json && ts-prune -p tsconfig.main.json && ts-prune -p tsconfig.preload.json",
    "dead-code:check": "npm run prune:all",
    "knip": "knip",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.8.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^9.1.2",
    "@tinymce/tinymce-react": "^6.3.0",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^12.43.0",
    "libreoffice-convert": "^1.8.1",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^8.3.0",
    "sanitize-html": "2.17.7",
    "sonner": "^2.0.8",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.6.0",
    "tinymce": "^8.8.2",
    "unpdf": "^1.8.1",
    "winston": "^3.11.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "prettier": "^3.1.0",
    "tailwindcss": "^4.3.3",
    "ts-prune": "^0.10.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "undici": "7.29.0",
    "node-gyp": {
      "undici": "6.28.0"
    },
    "fast-uri": "3.1.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "bcrypt@6.0.0": true,
    "electron@43.2.0": true
  }
}
